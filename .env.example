# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 被测项目配置
SWAGGER_PATH=target_service/swagger.json
BASE_URL=https://api.example.com

# 认证配置（适配任意鉴权方式）
AUTH_URL=/api/v1/user/login
AUTH_BODY={"email": "test@example.com", "password": "your-password"}
AUTH_TOKEN_PATH=data.accessToken