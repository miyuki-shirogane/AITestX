{
  "openapi": "3.0.0",
  "info": {"title": "solgrid-friend", "version": "v1"},
  "servers": [{"url": "https://solgrid-friend-api.rivtower.cc"}],
  "paths": {
    "/api/v1/user/login": {
      "post": {
        "tags": ["Users"],
        "summary": "用户/Agent登录",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {"type": "string", "description": "登录邮箱", "example": "denzelchendg@gmail.com"},
                  "password": {"type": "string", "description": "密码", "example": "88888888"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "code": {"type": "integer"},
                    "message": {"type": "string"},
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": {"type": "string"},
                        "refreshToken": {"type": "string"},
                        "expiresIn": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user/info": {
      "post": {
        "tags": ["Users"],
        "summary": "查询当前用户信息",
        "security": [{"JWTBearerAuth": []}],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "code": {"type": "integer"},
                    "data": {
                      "type": "object",
                      "properties": {
                        "nickname": {"type": "string"},
                        "avatar": {"type": "string"},
                        "email": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/locations": {
      "post": {
        "tags": ["Locations"],
        "summary": "查询地图地点列表",
        "security": [{"JWTBearerAuth": []}],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "code": {"type": "integer"},
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {"type": "string"},
                          "name": {"type": "string"},
                          "displayName": {"type": "string"},
                          "description": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/world/current-state": {
      "post": {
        "tags": ["World"],
        "summary": "查询世界当前状态",
        "security": [{"JWTBearerAuth": []}],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "code": {"type": "integer"},
                    "data": {
                      "type": "object",
                      "properties": {
                        "currentTime": {"type": "string"},
                        "timePhase": {"type": "string"},
                        "season": {"type": "string"},
                        "weatherKey": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "JWTBearerAuth": {
        "type": "http",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}